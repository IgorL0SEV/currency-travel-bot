# Telegram-бот: токен из @BotFather
TELEGRAM_BOT_TOKEN=123456:ВАШ_ТОКЕН_ИЗ_BOTFATHER

# Провайдер курсов: exchangerate_host | open_er_api
CURRENCY_PROVIDER=exchangerate_host

# Ключ exchangerate.host (нужен только для этого провайдера)
CURRENCY_API_KEY=ВАШ_КЛЮЧ_EXCHANGERATE_HOST

# 1 — если основной провайдер недоступен, попробовать второй (open.er-api.com)
CURRENCY_FALLBACK=1

# Сколько часов считать курс в кэше свежим (экономит лимит запросов)
RATE_CACHE_TTL_HOURS=12

# Путь к базе SQLite
DATABASE_PATH=data/wallet.db
